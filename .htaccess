# ============================================================
# WEBsynthiq — static hosting config (Hostinger / LiteSpeed / Apache)
# No build step. This file is the entire deploy configuration.
# ============================================================

RewriteEngine On

# ---------- 1. Force HTTPS ----------
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# ---------- 2. www -> non-www (canonicals are non-www) ----------
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# ---------- 3. Block internal working folders ----------
# These live in the repo but must never be publicly reachable.
RewriteRule ^(copy|execution|\.tmp|\.claude)(/|$) - [F,L]
RewriteRule ^Websynthiq - [F,L]

# Block source/doc file types anywhere in the tree (except root AGENTS.md)
<FilesMatch "\.(md|py|psd|ai|sketch|log)$">
  Require all denied
</FilesMatch>
<Files "AGENTS.md">
  Require all granted
</Files>

# ---------- 4. Extensionless URLs ----------
# Canonicals point to /website-design, files are website-design.html.
# /index.html -> /
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]

# /page.html -> /page  (301 so only one URL is live, matching the canonical)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Agents that send "Accept: text/markdown" get a Markdown copy of the page
# from md/ (generated by execution/build_markdown.py). Same URL, so the
# canonical never changes; Vary: Accept below keeps caches from mixing them.
RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
RewriteRule ^(about/?|contact/?)?$ md/index.markdown [L]
RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([a-z0-9-]+)/?$ md/$1.markdown [L]

# Redirect /about and /contact to homepage sections
RewriteRule ^about/?$ /#about [R=301,L,NE]
RewriteRule ^contact/?$ /#contact [R=301,L,NE]

# Internally serve /page from page.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# ---------- 5. Compression ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/xml
  AddOutputFilterByType DEFLATE image/svg+xml font/ttf
  AddOutputFilterByType DEFLATE text/markdown
</IfModule>

# Markdown copies for agents: correct type, never indexed as duplicates.
AddType "text/markdown; charset=utf-8" .markdown
AddCharset utf-8 .markdown .txt
<FilesMatch "\.markdown$">
  <IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex"
  </IfModule>
</FilesMatch>
<FilesMatch "\.(html|markdown)$">
  <IfModule mod_headers.c>
    Header append Vary Accept
  </IfModule>
</FilesMatch>

# RFC 8288 Link headers so agents can discover llms.txt and the Markdown
# alternate without parsing HTML. Homepage (index.html, also /about, /contact)
# gets the alternate; every HTML page gets llms.txt.
<FilesMatch "\.html$">
  <IfModule mod_headers.c>
    Header append Link '</llms.txt>; rel="describedby"; type="text/plain"'
  </IfModule>
</FilesMatch>
<Files "index.html">
  <IfModule mod_headers.c>
    Header append Link '</>; rel="alternate"; type="text/markdown"'
  </IfModule>
</Files>

# ---------- 6. Caching ----------
# Images and fonts are content-addressed by name and rarely change -> long.
# CSS/JS have no cache-busting hashes, so keep them short or edits won't
# reach returning visitors. HTML must never be cached.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html              "access plus 0 seconds"
  ExpiresByType text/markdown          "access plus 0 seconds"
  ExpiresByType text/css               "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType image/jpeg             "access plus 1 year"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 year"
  ExpiresByType font/ttf               "access plus 1 year"
  ExpiresByType font/woff2             "access plus 1 year"
</IfModule>

# ---------- 7. Security headers ----------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://widgets.leadconnectorhq.com https://*.leadconnectorhq.com https://stcdn.leadconnectorhq.com; style-src 'self' 'unsafe-inline' https://*.leadconnectorhq.com https://stcdn.leadconnectorhq.com https://fonts.bunny.net; img-src 'self' data: https:; font-src 'self' data: https://*.leadconnectorhq.com https://stcdn.leadconnectorhq.com https://fonts.bunny.net; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://analytics.google.com https://*.analytics.google.com https://*.googletagmanager.com https://services.leadconnectorhq.com https://*.leadconnectorhq.com https://*.msgsndr.com; frame-src 'self' https://link.websynthiq.com https://*.leadconnectorhq.com; frame-ancestors 'self';"
  Header always unset X-Powered-By
</IfModule>

# ---------- 8. Error page ----------
# No 404.html exists yet. Add one, then uncomment:
# ErrorDocument 404 /404.html
